# Copy to .env. Never commit .env itself.
#
# Local development: point at the mock server or backend on port 8000.
# Production behind same-domain Caddy routing: leave this empty.
VITE_API_URL=http://localhost:8000

# B8 insurance policy: replay a recorded run from demo/recorded_runs/ with the backend
# switched off entirely. Set true only when rehearsing or if the venue network dies.
VITE_DEMO_MODE=false
