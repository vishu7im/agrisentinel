# Public domain pointed at this VPS. Do not include https:// or a path.
APP_DOMAIN=agri.vishu.dev

# Keep this empty when Caddy serves the UI and /api from the same hostname.
# Set a full origin only if the API is hosted on a different domain.
VITE_API_URL=
VITE_DEMO_MODE=false

# Only needed when the browser UI is hosted on a different origin from /api.
# Example for a separately hosted UI: CORS_ORIGINS=https://agri.vishu.dev
CORS_ORIGINS=

# Optional. Without a key, the app uses its extractive offline fallback.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_VISION_MODEL=
GEMINI_BASE_URL=
AGRISENTINEL_OBSERVER=1
